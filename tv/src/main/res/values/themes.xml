<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher colour and shared-element transitions, as the TV "create an app" guide asks; no SplashScreen API on TV. -->
    <style name="Theme.HushTv" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/hush_primary</item>
        <item name="android:windowBackground">@color/hush_background</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
    </style>
</resources>
