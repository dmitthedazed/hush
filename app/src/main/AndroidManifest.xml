<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The shell: device modules (devices/*) bring their own permissions and components through manifest merging. -->
    <!-- The microphone test (any device with a mic); Bluetooth mics need the call route. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- The add screen looks for headphones in pairing mode; never used to work out where the phone is. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <application
        android:name=".HushApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Hush"
        android:description="@string/xposed_description"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hush">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <!-- Freeform windows (desktop Android, ChromeOS, DeX): open wide enough for two columns. -->
            <layout
                android:defaultWidth="960dp"
                android:defaultHeight="720dp"
                android:minWidth="320dp"
                android:minHeight="420dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <!-- Launcher long-press: Ask ChatGPT / Ask Claude. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- "All settings" on the watch opens the phone app here (RemoteActivityHelper). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hush" android:host="open" />
            </intent-filter>
        </activity>

        <!-- Home screen widgets: they show whichever device Hush would show (DeviceModules.current). -->
        <receiver android:name="com.occaecat.hush.widget.BatteryWidgetReceiver" android:exported="true" android:label="Hush · Battery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_battery" />
        </receiver>
        <receiver android:name="com.occaecat.hush.widget.StatusWidgetReceiver" android:exported="true" android:label="Hush · Status">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_status" />
        </receiver>
        <receiver android:name="com.occaecat.hush.widget.ControlsWidgetReceiver" android:exported="true" android:label="Hush · Controls">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_controls" />
        </receiver>
        <receiver android:name="com.occaecat.hush.widget.DashboardWidgetReceiver" android:exported="true" android:label="Hush · Dashboard">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_dashboard" />
        </receiver>
    </application>
</manifest>
